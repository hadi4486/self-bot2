# این فایل رو کپی کن به .env و مقادیرش رو پر کن
# روی Replit بهتره این مقادیر رو توی بخش Secrets قرار بدی، نه توی فایل .env

API_ID=1234567
API_HASH=your_api_hash_here
SESSION_STRING=
PREFIX=.
TIMEZONE_OFFSET=3.5
CLOCK_INTERVAL=60

